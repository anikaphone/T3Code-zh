+const ATTACHMENT_SUFFIX_RE = /^\n\nAttached (?:image|file) "(?:\\.|[^"\\\r\n])*": "/;
+const ANTIGRAVITY_QUESTION_KEY_RE = /^q([1-9]\d*)(_other)?$/;
+
+interface AntigravityQuestionOption {
+  readonly label: string;
+  readonly description: string;
+  readonly value: string;
+}
+
+interface AntigravityQuestionSpec {
+  readonly kind: "choice" | "otherOnly";
+  readonly otherId: string;
+  readonly required: boolean;
+  readonly question: OrchestrationV2UserInputQuestion & {
+    readonly options: ReadonlyArray<AntigravityQuestionOption>;
+  };
+}
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  return Predicate.isObject(value) && !Array.isArray(value);
+}
+
+function trimNonEmptyText(value: unknown): string | undefined {
+  if (typeof value !== "string") return undefined;
+  const trimmed = value.trim();
+  return trimmed.length > 0 ? trimmed : undefined;
+}
+
+function boundQuestionText(text: string): string {
+  return text.length > TOOL_TEXT_LIMIT
+    ? copyBoundedText(`${text.slice(0, TOOL_TEXT_LIMIT - 3)}...`)
+    : text;
+}
+
+function isPlainAntigravityOtherField(value: unknown): value is Record<string, unknown> {
+  return (
+    isPlainRecord(value) &&
+    value.type === "string" &&
+    value.enum === undefined &&
+    value.oneOf === undefined &&
+    value.anyOf === undefined &&
+    value.const === undefined
+  );
+}
+
+function parseAntigravityElicitationOptions(
+  field: Record<string, unknown>,
+  multiSelect: boolean,
+): ReadonlyArray<AntigravityQuestionOption> | undefined {
+  const source = multiSelect ? (isPlainRecord(field.items) ? field.items : undefined) : field;
+  if (!source) return undefined;
+
+  const options: Array<AntigravityQuestionOption> = [];
+  const rawChoices = multiSelect ? source.anyOf : source.oneOf;
+  if (Array.isArray(rawChoices)) {
+    for (const choice of rawChoices) {
+      if (!isPlainRecord(choice)) return undefined;
+      if (typeof choice.const !== "string" || choice.const.trim().length === 0) return undefined;
+      const label = trimNonEmptyText(choice.title) ?? choice.const.trim();
+      const description = trimNonEmptyText(choice.description) ?? label;
+      options.push({ label, description, value: choice.const });
+    }
+  } else if (
+    Array.isArray(source.enum) &&
+    (!multiSelect || source.type === undefined || source.type === "string")
+  ) {
+    const enumNames = Array.isArray(source.enumNames) ? source.enumNames : undefined;
+    for (let index = 0; index < source.enum.length; index++) {
+      const rawValue = source.enum[index];
+      if (typeof rawValue !== "string" || rawValue.trim().length === 0) return undefined;
+      const label = trimNonEmptyText(enumNames?.[index]) ?? rawValue.trim();
+      options.push({ label, description: label, value: rawValue });
+    }
+  } else {
+    return undefined;
+  }
+
+  if (options.length === 0) return undefined;
+  const seenValues = new Set<string>();
+  for (const option of options) {
+    if (seenValues.has(option.value)) return undefined;
+    seenValues.add(option.value);
+  }
+  return options;
+}
+
+function matchAntigravityAttachmentOption(
+  options: ReadonlyArray<AntigravityQuestionOption>,
+  answer: string,
+) {
+  const attachmentStart = answer.indexOf("\n\n");
+  if (attachmentStart < 0) return undefined;
+  const suffix = answer.slice(attachmentStart);
+  if (!ATTACHMENT_SUFFIX_RE.test(suffix)) return undefined;
+  const prefix = answer.slice(0, attachmentStart);
+  const option = options.find((candidate) => candidate.value === prefix);
+  return option ? { option, suffix } : undefined;
+}
+
+function resolveSingleAntigravityAnswer(
+  spec: AntigravityQuestionSpec,
+  rawAnswer: unknown,
+  contentEntries: Array<[string, string | Array<string>]>,
+): boolean {
+  const decoded = Option.getOrUndefined(decodeSingleAnswer(rawAnswer));
+  const value = typeof decoded === "string" ? decoded : decoded?.[0];
+  if (!Predicate.isString(value) || value.trim().length === 0) return false;
+  if (spec.kind === "otherOnly") {
+    contentEntries.push([spec.otherId, value]);
+    return true;
+  }
+  const exact = spec.question.options.find((option) => option.value === value);
+  if (exact) {
+    contentEntries.push([spec.question.id, exact.value]);
+    return true;
+  }
+  const attached = matchAntigravityAttachmentOption(spec.question.options, value);
+  if (attached) {
+    contentEntries.push(
+      [spec.question.id, attached.option.value],
+      [spec.otherId, `${attached.option.label}${attached.suffix}`],
+    );
+    return true;
+  }
+  contentEntries.push([spec.otherId, value]);
+  return true;
+}
+
+function resolveMultiAntigravityAnswer(
+  spec: AntigravityQuestionSpec,
+  rawAnswer: unknown,
+  contentEntries: Array<[string, string | Array<string>]>,
+): boolean {
+  const items = Array.isArray(rawAnswer)
+    ? rawAnswer
+    : Predicate.isString(rawAnswer)
+      ? [rawAnswer]
+      : undefined;
+  if (!items || items.length === 0) return false;
+
+  const selectedValues: Array<string> = [];
+  const customTexts: Array<string> = [];
+  for (const item of items) {
+    if (!Predicate.isString(item) || item.trim().length === 0) return false;
+    const exact = spec.question.options.find((option) => option.value === item);
+    if (exact) {
+      selectedValues.push(exact.value);
+      continue;
+    }
+    const attached = matchAntigravityAttachmentOption(spec.question.options, item);
+    if (attached) {
+      selectedValues.push(attached.option.value);
+      customTexts.push(`${attached.option.label}${attached.suffix}`);
+      continue;
+    }
+    customTexts.push(item);
+  }
+  if (selectedValues.length === 0 && customTexts.length === 0) return false;
+  if (selectedValues.length > 0) contentEntries.push([spec.question.id, selectedValues]);
+  if (customTexts.length > 0) contentEntries.push([spec.otherId, customTexts.join("\n")]);
+  return true;
+}
+
+/**
+ * Normalizes Antigravity's `elicitation/create` question forms (`q1`, `q1_other`, ...).
+ * Antigravity emits a separate `qN_other` free-form string companion alongside each choice question;
+ * collapsing each pair prevents the extra step with empty options from blocking multi-question flows.
+ */
+export const extractAntigravityElicitationForm: NonNullable<
+  AcpAdapterV2Flavor["extractElicitationForm"]
+> = (request) => {
+  if (request.mode !== "form" || !isPlainRecord(request.requestedSchema)) return undefined;
+  const properties = request.requestedSchema.properties;
+  if (!isPlainRecord(properties)) return undefined;
+  const rawEntries = Object.entries(properties);
+  if (rawEntries.length === 0) return undefined;
+
+  const groups = new Map<number, { readonly index: number; q?: unknown; other?: unknown }>();
+  for (const [key, field] of rawEntries) {
+    const match = ANTIGRAVITY_QUESTION_KEY_RE.exec(key);
+    if (!match) return undefined;
+    const index = Number(match[1]);
+    const group = groups.get(index) ?? { index };
+    if (match[2] === "_other") {
+      group.other = field;
+    } else {
+      group.q = field;
+    }
+    groups.set(index, group);
+  }
+
+  const requiredIds = new Set(
+    Array.isArray(request.requestedSchema.required)
+      ? request.requestedSchema.required.filter((key): key is string => typeof key === "string")
+      : [],
+  );
+  const sortedGroups = [...groups.values()].sort((a, b) => a.index - b.index);
+  const specs: Array<AntigravityQuestionSpec> = [];
+
+  for (const group of sortedGroups) {
+    const qKey = `q${group.index}`;
+    const otherKey = `${qKey}_other`;
+    if (group.q !== undefined) {
+      if (!isPlainRecord(group.q) || !isPlainAntigravityOtherField(group.other)) {
+        return undefined;
+      }
+      if (group.q.type !== "string" && group.q.type !== "array") return undefined;
+      const multiSelect = group.q.type === "array";
+      const options = parseAntigravityElicitationOptions(group.q, multiSelect);
+      if (!options) return undefined;
+
+      const title = trimNonEmptyText(group.q.title);
+      const description = trimNonEmptyText(group.q.description);
+      const stepLabel = `Question ${specs.length + 1}`;
+      const header = boundQuestionText(description !== undefined ? (title ?? stepLabel) : stepLabel);
+      const question = boundQuestionText(
+        description ?? title ?? trimNonEmptyText(request.message) ?? "Choose an option.",
+      );
+      specs.push({
+        kind: "choice",
+        otherId: otherKey,
+        required: requiredIds.has(qKey),
+        question: { id: qKey, header, question, options, multiSelect },
+      });
+    } else {
+      if (!isPlainAntigravityOtherField(group.other)) return undefined;
+      const title = trimNonEmptyText(group.other.title);
+      const description = trimNonEmptyText(group.other.description);
+      const stepLabel = `Question ${specs.length + 1}`;
+      const header = boundQuestionText(description !== undefined ? (title ?? stepLabel) : stepLabel);
+      const question = boundQuestionText(
+        description ?? title ?? trimNonEmptyText(request.message) ?? "Enter an answer.",
+      );
+      specs.push({
+        kind: "otherOnly",
+        otherId: otherKey,
+        required: requiredIds.has(otherKey),
+        question: { id: otherKey, header, question, options: [], multiSelect: false },
+      });
+    }
+  }
+
+  if (specs.length === 0) return undefined;
+
+  return {
+    questions: specs.map((spec) => spec.question),
+    respond: (answers) => {
+      const contentEntries: Array<[string, string | Array<string>]> = [];
+      for (const spec of specs) {
+        const answer = Object.hasOwn(answers, spec.question.id)
+          ? answers[spec.question.id]
+          : undefined;
+        if (answer === undefined) {
+          if (spec.required) return { action: "cancel" };
+          continue;
+        }
+        const ok = spec.question.multiSelect
+          ? resolveMultiAntigravityAnswer(spec, answer, contentEntries)
+          : resolveSingleAntigravityAnswer(spec, answer, contentEntries);
+        if (!ok) return { action: "cancel" };
+      }
+
+      if (contentEntries.length === 0) return { action: "cancel" };
+      return { action: "accept", content: Object.fromEntries(contentEntries) };
+    },
+  };
+};
+
 function boundText(text: string, limit = TOOL_TEXT_LIMIT): string {
   return text.length <= limit
     ? text
