# 基线 v0.1.10 / 7d32075e3757ded707914e2450c3e392a9665765；按编号顺序普通 apply。
# 0001-language-setting.patch
#
# 桥接上游 v0.1.10 原生「常规 / Language」选择器与 t3code-zh 运行时 window.__t3zh：
#   * 不再额外渲染第二个 Language 下拉框，统一使用上游原生的语言选择；
#   * 切换或重置语言持久化后同步写入 t3code-zh.locale，仅在 zh-CN / en 实际切换时重载；
#   * apps/web/src/i18n/runtime.ts 在 system 模式下优先读取桌面主进程暴露的 __t3zhSystemLanguages；
#   * apps/web/src/vite-env.d.ts 补充 __t3zh 与 __t3zhSystemLanguages 类型声明。
#
diff --git a/apps/web/src/components/settings/SettingsPanels.tsx b/apps/web/src/components/settings/SettingsPanels.tsx
index 633e18a567..a45a4f383e 100644
--- a/apps/web/src/components/settings/SettingsPanels.tsx
+++ b/apps/web/src/components/settings/SettingsPanels.tsx
@@ -72,6 +72,8 @@ import {
   selectsPlanAgent,
 } from "../../modelSelection";
 import { useTextGenerationTargets } from "../../textGenerators";
+import { updateClientSettings } from "../../hooks/useSettings";
+import { whenLocaleReady } from "../../i18n/runtime";
 import { ensureLocalApi, readLocalApi } from "../../localApi";
 import { isMacPlatform } from "../../lib/utils";
 import {
@@ -788,6 +790,32 @@ function useTranslatedSearchableSetting() {
   };
 }
 
+function applyUnifiedLanguage(language: string): void {
+  void updateClientSettings({ language }).then(async () => {
+    if (typeof window === "undefined" || !window.__t3zh) return;
+    await whenLocaleReady();
+    const nextPref = language === "system" ? "system" : language === "zh" ? "zh-CN" : "en";
+    const nextResolved =
+      nextPref === "zh-CN"
+        ? "zh-CN"
+        : nextPref === "en"
+          ? "en"
+          : document.documentElement.lang === "zh"
+            ? "zh-CN"
+            : "en";
+    if (window.__t3zh.getLocale() === nextPref) return;
+    if (nextResolved !== window.__t3zh.getResolvedLocale()) {
+      window.__t3zh.setLocale(nextPref);
+      return;
+    }
+    try {
+      window.localStorage?.setItem("t3code-zh.locale", nextPref);
+    } catch {
+      // Ignore storage restrictions; the active resolved locale is unchanged.
+    }
+  });
+}
+
 export function GeneralSettingsPanel() {
   const gt = useGT();
   const m = useMessages();
@@ -1063,11 +1091,7 @@ export function GeneralSettingsPanel() {
             settings.language !== DEFAULT_UNIFIED_SETTINGS.language ? (
               <SettingResetButton
                 label="language"
-                onClick={() =>
-                  updateSettings({
-                    language: DEFAULT_UNIFIED_SETTINGS.language,
-                  })
-                }
+                onClick={() => applyUnifiedLanguage(DEFAULT_UNIFIED_SETTINGS.language)}
               />
             ) : null
           }
@@ -1076,7 +1100,7 @@ export function GeneralSettingsPanel() {
               value={languageValue}
               onValueChange={(value) => {
                 if (value) {
-                  updateSettings({ language: value });
+                  applyUnifiedLanguage(value);
                 }
               }}
             >
diff --git a/apps/web/src/i18n/runtime.ts b/apps/web/src/i18n/runtime.ts
index 4fac3aec2a..3ff5f9796d 100644
--- a/apps/web/src/i18n/runtime.ts
+++ b/apps/web/src/i18n/runtime.ts
@@ -52,9 +52,13 @@ function activateLocale(locale: string): void {
 
 function applyLanguageSetting(): void {
   // Not desktopBridge.getSystemLocale(): that is the regional/time locale, not the UI language.
+  const systemLanguages =
+    Array.isArray(globalThis.__t3zhSystemLanguages) && globalThis.__t3zhSystemLanguages.length > 0
+      ? globalThis.__t3zhSystemLanguages
+      : navigator.languages;
   requestedLocale = resolveLocale(
     getClientSettings().language,
-    navigator.languages,
+    systemLanguages,
     SUPPORTED_LOCALES,
     DEFAULT_LOCALE,
   );
diff --git a/apps/web/src/vite-env.d.ts b/apps/web/src/vite-env.d.ts
index 63f7cca9cb..40328465e2 100644
--- a/apps/web/src/vite-env.d.ts
+++ b/apps/web/src/vite-env.d.ts
@@ -31,5 +31,14 @@ declare global {
       readonly replayScenarios: () => ReadonlyArray<string>;
       readonly replay: (scenario?: string) => Promise<ThreadId>;
     };
+    /** Injected by the zh-CN runtime (patches/0001-language-setting.patch). */
+    __t3zh?: {
+      getLocale(): "system" | "en" | "zh-CN";
+      getResolvedLocale(): "en" | "zh-CN";
+      setLocale(value: "system" | "en" | "zh-CN"): void;
+    };
   }
+  /** Exposed by desktop preload (patches/0003-desktop-main-zh.patch). */
+  // eslint-disable-next-line no-var
+  var __t3zhSystemLanguages: ReadonlyArray<string> | undefined;
 }
