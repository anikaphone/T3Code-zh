new file mode 100644
index 0000000000..71aca95aeb
--- /dev/null
+++ b/apps/web/src/newThreadDisplayStrings.ts
@@ -0,0 +1,58 @@
+/**
+ * t3code-zh（patches/0007）：新建任务页面上转换插件包不到的几处英文，只在显示处翻译。
+ *
+ * - 默认名：服务端给「无项目」任务用的临时项目起名 `No project`（apps/server/src/project/ManagedProjectFolders.ts），
+ *   新任务的默认标题是 `New thread`（web 草稿与服务端共用；ThreadTitleRegenerationService 按
+ *   `=== "New thread"` 判断要不要重新生成标题）。两者都是数据值，不能在定义处翻译，只能在渲染处按精确名单查表；
+ *   用户自己起的项目名、任务标题原样返回。
+ * - 句子中间嵌着组件或运行时值（`What should we build in <项目选择器>?`）：文字与表达式混排的 JSX 被插件记为
+ *   mixed-jsx 跳过。这里用一个私有区字符占住槽位，把「固定骨架 + 槽位」整句交给 t()，按词库的专用模板翻译后
+ *   在槽位处切开。t() 只会收到固定骨架，不会把项目名这类任意文字送进宽模板（CONVENTIONS §5 补丁规则 1、4）。
+ *
+ * 词条都在 dict/zh-CN.json；plugin/__tests__/new-thread-display-strings.test.ts 用真实主词库逐条核对。
+ * 名单写成普通数组再传给 Set，不写成 `new Set([...字面量])`——那种写法会被预扫描记为值用途，
+ * 影响别处同名文字的翻译。
+ */
+
+// 服务端 / 客户端起的默认名。
+const DEFAULT_NAMES: readonly string[] = ["New thread", "No project"];
+const defaultNames = new Set(DEFAULT_NAMES);
+
+/** 句子槽位的占位字符（Unicode 私有区），不会出现在词库和界面文字里。 */
+const SLOT = "";
+
+function translate(value: string): string {
+  return globalThis.__t3zh?.t?.(value) ?? value;
+}
+
+/** 名单里的默认名查表翻译，其余（含 null / undefined）原样返回。 */
+export function displayDefaultName(value: string): string;
+export function displayDefaultName(value: string | undefined): string | undefined;
+export function displayDefaultName(value: string | null): string | null;
+export function displayDefaultName(value: string | null | undefined): string | null | undefined;
+export function displayDefaultName(value: string | null | undefined): string | null | undefined {
+  if (typeof value !== "string" || !defaultNames.has(value)) return value;
+  return translate(value);
+}
+
+/**
+ * 句子 `before + <槽位> + after` 按词库模板翻译后在槽位处切开，返回 [槽位前, 槽位后]。
+ * 没有命中模板、或译文里的槽位不是恰好一个时，返回原样的 [before, after]（en 模式即如此）。
+ */
+export function translateAroundSlot(before: string, after: string): [string, string] {
+  const translated = translate(before + SLOT + after);
+  const index = translated.indexOf(SLOT);
+  if (index < 0 || translated.indexOf(SLOT, index + SLOT.length) >= 0) return [before, after];
+  return [translated.slice(0, index), translated.slice(index + SLOT.length)];
+}
+
+/** 同 translateAroundSlot，槽位处直接填入文字（调用方负责先对默认名调用 displayDefaultName）。 */
+export function fillSlot(before: string, value: string, after: string): string {
+  const [head, tail] = translateAroundSlot(before, after);
+  return head + value + tail;
+}
+
+/** 固定字面量的显示翻译。只用于词库里有精确 messages 词条的字面量，不传任意文字。 */
+export function translateFixed(value: string): string {
+  return translate(value);
+}
