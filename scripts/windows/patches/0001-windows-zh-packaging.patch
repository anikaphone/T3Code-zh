# 0001-windows-zh-packaging.patch（仅 Windows 构建，T21-W）
#
# 由 scripts/windows/prepare-source.ts 在共享 patches/ 全部应用之后、仅当 --platform win 时应用；
# Mac 交付构建（scripts/build-zh.sh）不使用本补丁。基线 v0.1.8（bf469bb19669671d0df2efda74ed73867a7137c0）。
#
# 只改打包脚本 scripts/build-desktop-artifact.ts（不进 app），三处，都只影响 platform === "win"：
#   1. electronLanguages 在 Windows 上额外保留 "zh-CN"：win-unpacked/locales/zh-CN.pak 打进包，
#      中文 Windows 上 Chromium 自带文字（右键菜单、拼写检查、文件对话框等）显示中文。
#      应用界面语言仍由 runtime 的 __t3zhSystemLanguages 决定（CONVENTIONS §5），不受影响。
#   2. NSIS 单语简体中文安装器：installerLanguages ["zh_CN"]；language "2052" 让安装器版本资源也用 zh-CN。
#      electron-builder 自带的 messages.yml 有 3 条罕见错误提示（decompressionFailed、
#      uninstallFailed、appClosing）没有 zh_CN，会回退英文，属上游限制（T23 起 electron-builder 26.16.1）。
#   3. WINDOWS_PACKAGED_PAYLOAD_FILE_LIMIT 80 → 80 + 30：上游在 Linux 交叉构建 Windows（跳过
#      prepare-server-compile-cache.cjs），本项目在原生 Windows 上构建会额外生成 server-compile-cache
#      （22 个字节码文件）、原生编译 conpty（2 个）并多出 T3-Code-LICENSE.txt 与 locales/zh-CN.pak（2 个）。
#
# 上游改了这几处时：按 v0.1.8 原文重做，git apply --check 通过后再跑 scripts/windows/windows-ci.test.ts。
#
diff --git a/scripts/build-desktop-artifact.ts b/scripts/build-desktop-artifact.ts
index 2fff4919c..7d9d27ef5 100644
--- a/scripts/build-desktop-artifact.ts
+++ b/scripts/build-desktop-artifact.ts
@@ -1061,7 +1061,10 @@ export function resolveWindowsServerAsarIgnoreGlobs(arch: typeof BuildArch.Type)
   ];
 }
 
-export const WINDOWS_PACKAGED_PAYLOAD_FILE_LIMIT = 80;
+// t3code-zh（仅 Windows 构建）：上游 CI 在 Linux 上交叉打包 Windows（跳过 prepare-server-compile-cache.cjs），
+// 本项目在原生 Windows runner 上构建，多出 server-compile-cache（22 个字节码文件）、原生编译 conpty（2 个）
+// 及 T3-Code-LICENSE.txt、locales/zh-CN.pak（2 个）（v0.1.8 实测 91~93 个文件）。上限同步 +30。
+export const WINDOWS_PACKAGED_PAYLOAD_FILE_LIMIT = 80 + 30;
 export const WINDOWS_SERVER_RESOURCE_SOURCE_DIR = "apps/desktop/prod-resources/windows-server";
 export const WINDOWS_SERVER_EXTRA_RESOURCES = [
   {
@@ -2784,7 +2787,12 @@ export const createBuildConfig = Effect.fn("createBuildConfig")(function* (
     appId: DESKTOP_APP_ID,
     productName: resolveDesktopProductName(version),
     artifactName: "T3-Code-${version}-${arch}.${ext}",
-    electronLanguages: [...DESKTOP_ELECTRON_LANGUAGES],
+    // t3code-zh（仅 Windows 构建）：额外保留 Chromium 的 zh-CN locale pak，中文 Windows 上
+    // 右键菜单、拼写检查、文件对话框等 Chromium 自带文字随系统显示中文。
+    electronLanguages:
+      platform === "win"
+        ? [...DESKTOP_ELECTRON_LANGUAGES, "zh-CN"]
+        : [...DESKTOP_ELECTRON_LANGUAGES],
     files: [
       ...DESKTOP_FILE_EXCLUSIONS,
       ...(platform === "mac"
@@ -2950,9 +2958,14 @@ export const createBuildConfig = Effect.fn("createBuildConfig")(function* (
 
   if (platform === "win") {
     buildConfig.npmRebuild = false;
+    // t3code-zh（仅 Windows 构建）：单语简体中文安装器；安装器版本资源的语言也用 2052（zh-CN），支持自定义安装路径。
     buildConfig.nsis = {
       differentialPackage: true,
       include: "apps/desktop/resources/installer.nsh",
+      oneClick: false,
+      allowToChangeInstallationDirectory: true,
+      installerLanguages: ["zh_CN"],
+      language: "2052",
     };
     const winConfig: Record<string, unknown> = {
       target: [target],
